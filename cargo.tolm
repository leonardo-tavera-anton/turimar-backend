[package]
name = "turimar-backend"
version = "0.1.0"
edition = "2021"

[dependencies]
axum = "0.7"
tokio = { version = "1.0", features = ["full"] }
sqlx = { version = "0.7", features = ["runtime-tokio-native-tls", "postgres"] }
tower-http = { version = "0.5", features = ["cors"] }
serde = { version = "1.0", features = ["derive", "serde_derive"] }
dotenvy = "0.15"